# docker compose reads a file named `.env` in this directory automatically.
# Copy this to `.env` to override any of the defaults below.

# Serial source for the backend container. Default points at the Windows-side
# serial-bridge (serial-bridge/run-bridge.bat). Change the port here if you
# started the bridge with a different BRIDGE_LISTEN_PORT.
SERIAL_PORT=socket://host.docker.internal:9600
SERIAL_BAUD=9600

# Host ports to publish.
FRONTEND_PORT=3000
BACKEND_PORT=8000
