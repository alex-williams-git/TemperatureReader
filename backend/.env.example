# Copy to .env and adjust for your machine. .env is gitignored.

# Windows: COM3 / COM4 ...   Linux or Docker: /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=COM3
SERIAL_BAUD=9600

DB_PATH=./data/readings.db

# Comma-separated origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=http://localhost:3000
