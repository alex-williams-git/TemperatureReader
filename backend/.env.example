# Copy to .env and adjust for your machine. .env is gitignored.

# Serial source. Accepts a device name or a pyserial URL:
#   COM3                                  Windows, native
#   /dev/ttyACM0                          Linux, native
#   socket://host.docker.internal:9600    Docker (via the serial-bridge helper)
SERIAL_PORT=COM3
SERIAL_BAUD=9600

DB_PATH=./data/readings.db

# Comma-separated origins allowed to call the API directly (cross-origin).
# Unused when the frontend reaches the API through its same-origin /api proxy
# (the default docker-compose setup), but needed if you point a browser or the
# Next dev server straight at :8000.
CORS_ORIGINS=http://localhost:3000
