# Copy to .env.local. Usually you don't need to set anything here.

# The dashboard calls the backend through a same-origin proxy: the browser
# hits /api/*, and the Next server forwards it to BACKEND_ORIGIN (configured
# in next.config.ts). Default is http://localhost:8000 for native `next dev`.
# BACKEND_ORIGIN=http://localhost:8000

# Only set this to BYPASS the proxy and call the backend cross-origin from the
# browser (you'd then also need the backend's CORS_ORIGINS to include :3000):
# NEXT_PUBLIC_API_BASE=http://localhost:8000
